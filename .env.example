# Powers cross-device sync for the Live Game tab.
# Create a free Redis database at https://upstash.com (or via Vercel's
# Storage/Marketplace tab), then copy its REST URL and token here.
# The KV_REST_API_URL / KV_REST_API_TOKEN names from Vercel's integration also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
