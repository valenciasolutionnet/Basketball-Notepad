# Powers the access gate (stores access codes).
# Create a free Redis database at https://upstash.com (or via Vercel's
# Storage/Marketplace tab), then copy its REST URL and token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Access gate (paid through Stripe = automatic access, everyone else waits for approval).
# Build-time: "on" turns the gate on. Leave it unset to keep the app open.
VITE_ACCESS_GATE=
# Build-time: the Curling Notepad Stripe payment link shown on the "Buy now" button.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/dRmbIU9Ea8RI8ae4Ff1RC0c
# Server: restricted key with "Checkout Sessions: Read" permission.
STRIPE_SECRET_KEY=
# Server: the Curling Notepad product in Stripe.
STRIPE_PRODUCT_ID=prod_VJooZbmpNnCDxk
# Server: long random string (16+ chars) you type into /?admin.
ACCESS_ADMIN_KEY=
